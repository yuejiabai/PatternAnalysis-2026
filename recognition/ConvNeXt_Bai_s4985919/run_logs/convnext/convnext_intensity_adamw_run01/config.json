{
  "model": "convnext",
  "batch_size": 8,
  "learning_rate": 0.0003,
  "seed": 42,
  "optimizer_name": "adamw",
  "weight_decay": 0.03,
  "training_augmentation": true,
  "intensity_augmentation": {
    "version": 1,
    "scale_range": [
      0.9,
      1.1
    ],
    "gamma_range": [
      0.9,
      1.1
    ],
    "probability": 1.0,
    "formula": "clip(scale * x**gamma, 0, 1)",
    "order": "intensity then original affine then original noise",
    "rng": "python random (saved by train.py)",
    "scope": "training only"
  },
  "target_epochs": 8,
  "train_images": 10080,
  "val_images": 2620,
  "test_images": 9000,
  "class_to_idx": {
    "AD": 0,
    "NC": 1
  },
  "metric_positive_class": "AD (class 0)",
  "selection_metric": "macro_f1 (tie: recall_ad, then lower val_loss)",
  "selection_level": "slice",
  "selection_threshold": 0.5,
  "preprocessing_repr": "Compose(\n    Resize(size=(224, 224), interpolation=bilinear, max_size=None, antialias=warn)\n    Grayscale(num_output_channels=3)\n    ToTensor()\n    Normalize(mean=[0.5, 0.5, 0.5], std=[0.5, 0.5, 0.5])\n)",
